{
  "expo": {
    "name": "RMW CRM",
    "slug": "rmw-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/crm-icon.png",
    "scheme": "rmwcrm",
    "userInterfaceStyle": "light",
    "backgroundColor": "#160E33",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ritzmediaworld.crm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ritzmediaworld.crm",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/crm-maskable.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160E33",
          "image": "./assets/images/crm-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B3FD6",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "RMW CRM uses your photos to set your profile picture.",
          "cameraPermission": "RMW CRM uses the camera to take your profile picture."
        }
      ],
      "expo-audio",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "crmUrl": "https://crm.ritzmediaworld.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ad9244ee-eed5-4023-b4bd-b719cc09187b"
      }
    },
    "owner": "aryan_1212",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ad9244ee-eed5-4023-b4bd-b719cc09187b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
